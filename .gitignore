# Build products — regenerate with ./build.sh. Matched by shape rather than by
# name so this branch's differently-named bundle is covered too, and so a build
# of one never lands in a commit made on the other.
*.app/
*.zip

.DS_Store

# Derived texture cache — regenerated by build.sh from Art/Textures
.texcache/

# Derived animation frames — regenerated by build.sh from Art/Vectors
.animcache/

# Derived mood icons and AppIcon.icns — regenerated by build.sh from Art/AppIcons
.iconcache/
